function ttrans,yf,yif,p,q ; gets the transformation matrix

y1x=float(yf(0))
y1y=imaginary(yf(0))

y2x=float(yf(1))
y2y=imaginary(yf(1))

i1x=float(yif(0))
i1y=imaginary(yif(0))

i2x=float(yif(1))
i2y=imaginary(yif(1))

b=(q*y1x-p*y1y)/(y2y*y1x-y2x*y1y)

a=(p-y2x*b)/y1x

m=a*yif(0)+b*yif(1)

return,m
end


function userpoints,im
device,retain=2
s=size(im)
print,s
window,0,xs=s(1),ys=s(2),title="Select unit cell.."
goldpalette,/pure
tvscl,lineslope(im)

    cursor,x1,y1,/down,/device
    device, set_graphics_function = 6; XOR graphics
    mbd=!mouse.button
    x2d=x1
    y2d=y1
    mb=mbd

    ;the axes
    plots,[0,s(1)],[y1,y1],/device
    plots,[x1,x1],[0,s(2)],/device
    
    repeat begin
	cursor,x2,y2,/change,/device
	if x2d ne x2 or y2d ne y2 then begin
	    plots,[2*x1-x2d,x2d],[2*y1-y2d,y2d],/device
	    plots,[2*x1-x2,x2],[2*y1-y2,y2],/device   
	    x2d=x2
	    y2d=y2    
	end
	
	mb=!mouse.button
	if mb ne mbd then $
	if mbd eq 0 and mb eq 1 then begin
	    mb=99 ;exit code
	end else begin
	    mbd=mb
	end
	
    endrep until mb eq 99

    x2d=x1
    y2d=y1
    mb=mbd
    mbd=!mouse.button
    repeat begin
	cursor,x3,y3,/change,/device
	if x2d ne x3 or y2d ne y3 then begin
	    plots,[2*x1-x2d,x2d],[2*y1-y2d,y2d],/device
	    plots,[2*x1-x3,x3],[2*y1-y3,y3],/device   
	    x2d=x3
	    y2d=y3    
	end
	
	mb=!mouse.button
	if mb ne mbd then $
	if mbd eq 0 and mb eq 1 then begin
	    mb=99 ;exit code
	end else begin
	    mbd=mb
	end
	
    endrep until mb eq 99



;plots,[x1,x2],[y1,y2],/device   

device, set_graphics_function = 3; copy graphics

wdelete,0

a=complex(x2-x1,y2-y1)
b=complex(x3-x1,y3-y1)

return,[a,b]
end



function inventpoints,y
;fixes the triangle
a=y(0)
b=y(1)
;the point of crossing (x)
a1=float(a)
a2=imaginary(a)
b1=float(b)
b2=imaginary(b)
k=a2/(a2-b2)
x=a1-k*(a1-b1)
;x=complex(x,0)
;the ratio between the arms
alpha=abs(a-x)/abs(a-b)
help,alpha

;length of the fixed vector
at=x/(3./4.+(1./2.-alpha)^2)^0.5
help,at
;the angle between the fixed vector and the x axis (RAD)
;print,3.^0.5*at/2./x
gamma=!PI/6.-sgn(1./2.-alpha)*acos(3.^0.5*at/2./x)
;help,gamma
;the resulting vector
a=at*complex(cos(gamma),sin(gamma))
;the other vector is just turned -60DEG
b=a/complex(cos(!PI/3),sin(!PI/3))
;voila!
return,[a,b]
end

function hexdrift,imf,n=n,wps,orient=orient,recut=recut
;im - the image
;removes drift by asking the user for the axes and uses the X axis as the most reliable
;n - expansion; max. expansion 2x
;orient - the angle between the first vector and the X axis in degrees in the result, if not set, no correction done
;wps - a named var which returns the set of points used in warp_tri, if set, ignores everything and warps the image as desired
;the same could be achieved with warp_tri though

im=imf ;make a copy
s=size(im)

if keyword_set(wps) then begin
    gix=wps(*,0)
    giy=wps(*,1)
    imm=warp_tri(wps(*,0),wps(*,1),wps(*,2),wps(*,3),im); no filtering
end

;vectors: real part x, imaginary is y, have to be one above the X axis, second below; otherwise you get nonsense
y=userpoints(im)

;print,y

;define the correct vectors, needs to be calculated
yi=inventpoints(y)

;print,yi

;fix the orientation

if keyword_set(orient) then begin
    rotfix=yi(0)/abs(yi(0))
    rot30=complex(cos(!PI/6.),sin(!PI/6.))
    rot=rot30/rotfix
    yi(0)=yi(0)*rot
    yi(1)=yi(1)*rot
end


if not(keyword_set(n)) then begin
n=2.0
im=filter(im,{type:["stuff"],par1:[n]})
end else $
begin
;limit the expansion
n=n<2.0
;expand the borders of the image
im=filter(im,{type:["stuff"],par1:[n]})
end



help,n
help,im

gx=[0.,s(1)*n,0.,s(1)*n]
gy=[0.,0.,s(2)*n,s(2)*n]

ggg=ttrans(y,yi,gx,gy)



;print,ggg

;returns the coordinates of the new image corners

gix=float(ggg)
giy=float(imaginary(ggg))


;need to be centered ...? check it then

gix=gix-mean(gix)+n*s(1)/2
giy=giy-mean(giy)+n*s(2)/2 

gixh=(gix-mean(gix))/2+n*s(1)/2
giyh=(giy-mean(giy))/2+n*s(2)/2 



imm=warp_tri(gix,giy,gx,gy,im); no filtering

print,gixh
print,giyh

;recut
xmn=min(gixh)>0
xmx=max(gixh)<(n*s(1)-1)
ymn=min(giyh)>0
ymx=max(giyh)<(n*s(2)-1)


print,xmn,xmx,ymn,ymx
help,imm

if keyword_set(recut) then imm=imm(xmn:xmx,ymn:ymx)

if keyword_set(wps) then begin 
wps=[[gix],[giy],[gx],[gy]] ;after the check test if division by n successful
;print,"passed"
;print,wps
end

return,imm
end