<script>
if ('scrollRestoration' in history) {
  history.scrollRestoration = 'manual';
}

function scrollToActiveImage() {
  var targetImage = document.getElementById('<?echo 'img'.$index;?>');
  if (targetImage) {
    targetImage.scrollIntoView({ behavior: 'auto', block: 'center', inline: 'center' });
  }
}

document.addEventListener('DOMContentLoaded', scrollToActiveImage);
window.addEventListener('load', scrollToActiveImage);

var activeImg = document.getElementById('<?echo 'img'.$index;?>');
if (activeImg) {
  if (activeImg.complete) {
    scrollToActiveImage();
  } else {
    activeImg.addEventListener('load', scrollToActiveImage);
  }
}
</script>


